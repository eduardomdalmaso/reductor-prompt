# ==============================================================================
# ReductorPrompt - Configuração de Ambiente
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Provedor de LLM Ativo ('gemini' ou 'ollama')
# ------------------------------------------------------------------------------
LLM_PROVIDER=ollama

# ------------------------------------------------------------------------------
# 2. Configurações do Google Gemini (Nuvem - se LLM_PROVIDER=gemini)
# Modelos suportados:
#   - gemini-2.5-flash      (Recomendado: ultra rápido, inteligente e econômico)
#   - gemini-2.5-pro        (Raciocínio complexo e análises profundas)
#   - gemini-1.5-flash
#   - gemini-1.5-pro
# ------------------------------------------------------------------------------
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3. Configurações do Ollama (Local - se LLM_PROVIDER=ollama)
# Modelos LLM recomendados para RTX 5090 (32GB VRAM):
#   - qwen2.5-coder:32b     (Instalado! Excelente para arquitetura, dados e código)
#   - deepseek-r1:32b       (Raciocínio profundo e análise estruturada de projetos)
#   - llama3.3:70b          (Quantizado q4_k_m para máxima inteligência)
#   - mistral-nemo:12b      (Opção leve e rápida)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5-coder:32b

# Modelos de Embeddings recomendados no Ollama (Custo Zero de Token):
#   - nomic-embed-text      (Instalado! 768 dimensões, excelente precisão)
#   - bge-m3                (1024 dimensões, suporte multilíngue avançado)
#   - all-minilm            (384 dimensões, ultra leve)
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBEDDING_PROVIDER=ollama

# ------------------------------------------------------------------------------
# 4. Banco Vetorial ChromaDB (Container Podman na porta 8001)
# ------------------------------------------------------------------------------
CHROMA_MODE=http
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001

# ------------------------------------------------------------------------------
# 5. Diretórios de Trabalho
# ------------------------------------------------------------------------------
DATABASE_DIR=./database
STORAGE_DIR=./storage
CHROMA_PERSIST_DIR=./storage/chroma

# ------------------------------------------------------------------------------
# 6. Parâmetros de Otimização de Tokens (Calibrados para RTX 5090)
# ------------------------------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=150
DEFAULT_TOP_K=5
DEFAULT_MAX_CONTEXT_TOKENS=2500
SIMILARITY_THRESHOLD=0.25
