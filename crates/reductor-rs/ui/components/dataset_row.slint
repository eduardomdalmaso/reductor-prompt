import { Theme } from "../theme/palette.slint";

export component DatasetRow inherits Rectangle {
    in-out property <string> title: "";
    in-out property <string> format_type: "PDF";
    in-out property <string> chunks_count: "242 Chunks";
    in-out property <string> author: "Mara Bos";
    callback inspect_clicked();

    height: 64px;
    background: Theme.surface-elevated;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 16px;

        // 1. Tipo do Arquivo (Centralizado verticalmente)
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 60px;
                height: 26px;
                background: Theme.accent-subtle;
                border-radius: 4px;
                border-width: 1px;
                border-color: #ff5e3a33;
                Text {
                    width: 100%; height: 100%;
                    text: format_type; font-size: 11px; font-weight: 800; letter-spacing: 0.5px;
                    color: Theme.accent-primary; horizontal-alignment: center; vertical-alignment: center;
                }
            }
        }

        // 2. Título do Livro e Autor (Centralizado verticalmente)
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 3px;
            Text { text: title; font-size: 13px; font-weight: 700; color: Theme.text-primary; overflow: elide; }
            Text { text: author; font-size: 11px; color: Theme.text-dim; overflow: elide; }
        }

        // 3. Chunks (Centralizado verticalmente)
        VerticalLayout {
            alignment: center;
            Rectangle {
                height: 26px;
                background: #00ff9d14;
                border-radius: 4px;
                border-width: 1px;
                border-color: #00ff9d33;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px; alignment: center;
                    Text { text: chunks_count; font-size: 11px; font-weight: 700; color: Theme.status-success; vertical-alignment: center; }
                }
            }
        }

        // 4. Botão Lupa de Inspeção em Laranja (Centralizado verticalmente)
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 36px;
                height: 36px;
                background: inspect_touch.pressed ? Theme.accent-active : (inspect_touch.has-hover ? Theme.accent-primary : Theme.accent-subtle);
                border-radius: 8px;
                border-width: 1px;
                border-color: inspect_touch.has-hover ? Theme.accent-hover : #ff5e3a55;
                animate background { duration: 120ms; }

                Path {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 16px;
                    height: 16px;
                    stroke: inspect_touch.has-hover ? #ffffff : Theme.accent-primary;
                    stroke-width: 2px;
                    commands: "M 6.5 2 A 4.5 4.5 0 1 0 6.5 11 A 4.5 4.5 0 1 0 6.5 2 M 9.8 9.8 L 14.5 14.5";
                }

                inspect_touch := TouchArea { clicked => { inspect_clicked(); } }
            }
        }
    }
}
