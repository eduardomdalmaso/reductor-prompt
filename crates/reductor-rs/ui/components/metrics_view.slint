import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme/palette.slint";
import { MetricKpiCard } from "metric_kpi_card.slint";
import { MetricHistoryRow } from "metric_history_row.slint";

export struct HistoryItem {
    timestamp: string,
    mode_badge: string,
    query_title: string,
    chunks_count: string,
    tokens_saved: string,
    latency: string,
}

export component MetricsView inherits Rectangle {
    in-out property <string> kpi_saved_tokens: "0.0%";
    in-out property <string> kpi_saved_tokens_sub: "0 tokens evitados";
    in-out property <string> kpi_total_queries: "0";
    in-out property <string> kpi_avg_latency: "0ms";
    in-out property <string> kpi_saved_cost: "$0.00";
    in-out property <float> compression_ratio: 0.0;
    in-out property <string> compression_text: "Aguardando primeira consulta para calcular compressão...";
    in-out property <[HistoryItem]> history_items: [];

    background: Theme.background;

    VerticalLayout {
        padding: 24px;
        spacing: 14px;

        // Header
        HorizontalLayout {
            alignment: space-between;
            VerticalLayout {
                spacing: 3px;
                Text { text: "MÉTRICAS & HISTÓRICO DE EFICIÊNCIA"; font-size: 15px; font-weight: 800; letter-spacing: 0.8px; color: Theme.text-primary; }
                Text { text: "Auditoria de redução de tokens (>95%), telemetria de latência e histórico de execuções."; font-size: 11px; color: Theme.text-dim; }
            }
            Rectangle {
                height: 26px; background: #00ff9d14; border-radius: 4px; border-width: 1px; border-color: #00ff9d33;
                HorizontalLayout {
                    padding-left: 10px; padding-right: 10px;
                    Text { text: "● Telemetria Ativa"; font-size: 10px; font-weight: 800; color: Theme.status-success; vertical-alignment: center; }
                }
            }
        }

        // 4 KPI Cards Grid
        HorizontalLayout {
            spacing: 12px;
            MetricKpiCard { horizontal-stretch: 1; title: "ECONOMIA DE TOKENS"; value_text: kpi_saved_tokens; subtitle_text: kpi_saved_tokens_sub; value_color: Theme.status-success; }
            MetricKpiCard { horizontal-stretch: 1; title: "CONSULTAS RAG"; value_text: kpi_total_queries; subtitle_text: "Processadas na sessão"; value_color: Theme.accent-primary; }
            MetricKpiCard { horizontal-stretch: 1; title: "LATÊNCIA MÉDIA"; value_text: kpi_avg_latency; subtitle_text: "RRF + Embeddings"; value_color: #00e5ff; }
            MetricKpiCard { horizontal-stretch: 1; title: "CUSTO EVITADO"; value_text: kpi_saved_cost; subtitle_text: "Equivalente Cloud"; value_color: #e6db74; }
        }

        // Barra Comparativa de Eficiência
        Rectangle {
            height: 48px; background: Theme.surface; border-radius: 8px; border-width: 1px; border-color: Theme.border;
            VerticalLayout {
                padding-left: 14px; padding-right: 14px; padding-top: 8px; padding-bottom: 8px; spacing: 6px;
                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "TAXA DE COMPRESSÃO CONTEXTUAL"; font-size: 10px; font-weight: 800; color: Theme.text-dim; }
                    Text { text: compression_text; font-size: 10px; font-weight: 800; color: Theme.status-success; }
                }
                Rectangle {
                    height: 8px; background: #232734; border-radius: 4px; clip: true;
                    Rectangle { x: 0px; y: 0px; width: parent.width * compression_ratio; height: parent.height; background: Theme.status-success; border-radius: 4px; }
                }
            }
        }

        // Tabela de Histórico
        Rectangle {
            vertical-stretch: 1; background: Theme.surface; border-radius: 10px; border-width: 1px; border-color: Theme.border;
            VerticalLayout {
                padding: 14px; spacing: 8px;

                // Header das Colunas
                HorizontalLayout {
                    padding-left: 14px; padding-right: 14px; spacing: 12px;
                    Text { width: 55px; text: "HORA"; font-size: 10px; font-weight: 800; color: Theme.text-dim; }
                    Text { width: 65px; text: "MODO"; font-size: 10px; font-weight: 800; color: Theme.text-dim; }
                    Text { horizontal-stretch: 1; text: "CONSULTA TÉCNICA"; font-size: 10px; font-weight: 800; color: Theme.text-dim; }
                    Text { width: 80px; text: "CHUNKS"; font-size: 10px; font-weight: 800; color: Theme.text-dim; horizontal-alignment: right; }
                    Text { width: 80px; text: "ECONOMIA"; font-size: 10px; font-weight: 800; color: Theme.text-dim; horizontal-alignment: right; }
                    Text { width: 55px; text: "LATÊNCIA"; font-size: 10px; font-weight: 800; color: Theme.text-dim; horizontal-alignment: right; }
                }

                ScrollView {
                    VerticalLayout {
                        spacing: 6px;
                        for item in history_items : MetricHistoryRow {
                            timestamp: item.timestamp;
                            mode_badge: item.mode_badge;
                            query_title: item.query_title;
                            chunks_count: item.chunks_count;
                            tokens_saved: item.tokens_saved;
                            latency: item.latency;
                        }
                    }
                }
            }
        }
    }
}
