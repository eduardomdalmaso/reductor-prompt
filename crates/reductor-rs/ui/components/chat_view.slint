import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme/palette.slint";

export component CitationPill inherits Rectangle {
    in-out property <string> title: "";
    in-out property <string> score: "89%";

    height: 28px;
    background: Theme.surface-elevated;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        alignment: center;

        Text { text: title; font-size: 11px; font-weight: 600; color: Theme.accent-primary; vertical-alignment: center; }
        Text { text: "★ " + score; font-size: 10px; font-weight: 700; color: Theme.status-success; vertical-alignment: center; }
    }
}

export component ChatView inherits Rectangle {
    in-out property <string> last_query: "";
    in-out property <string> response_text: "Pronto para consultas. Digite sua dúvida na barra inferior para auditar sua arquitetura com a biblioteca de livros.";
    in-out property <bool> is_searching: false;
    callback copy_response_clicked(string);

    background: Theme.background;

    VerticalLayout {
        padding: 20px;
        spacing: 12px;

        // Bloco Unificado: Pergunta (Topo) + Resposta dos Livros (Embaixo)
        Rectangle {
            vertical-stretch: 1;
            background: Theme.surface;
            border-radius: 12px;
            border-width: 1px;
            border-color: is_searching ? Theme.accent-primary : Theme.border;

            ScrollView {
                VerticalLayout {
                    padding: 24px;
                    spacing: 18px;

                    // 1. Pergunta Técnica no Topo do Bloco
                    if last_query != "" : VerticalLayout {
                        spacing: 6px;
                        HorizontalLayout {
                            alignment: space-between;
                            Text { text: "PERGUNTA AUDITADA"; font-size: 11px; font-weight: 800; letter-spacing: 0.8px; color: Theme.accent-primary; }
                            Text { text: "RAG SEMÂNTICO"; font-size: 10px; font-weight: 700; color: Theme.text-dim; }
                        }
                        TextInput {
                            text: last_query; read-only: true; font-size: 15px; font-weight: 700;
                            color: Theme.text-primary; wrap: word-wrap;
                        }
                    }

                    // Linha Divisória
                    if last_query != "" : Rectangle { height: 1px; background: Theme.border; }

                    // 2. Diagnóstico e Resposta da IA Embaixo
                    VerticalLayout {
                        spacing: 8px;
                        HorizontalLayout {
                            alignment: space-between;
                            HorizontalLayout {
                                spacing: 8px; alignment: center;
                                Rectangle { width: 8px; height: 8px; border-radius: 4px; background: is_searching ? Theme.accent-primary : Theme.status-success; }
                                Text {
                                    text: is_searching ? "PROCESSANDO CONSULTA VETORIAL & LLM..." : "DIAGNÓSTICO TÉCNICO & TEORIA DOS LIVROS";
                                    font-size: 11px; font-weight: 800; letter-spacing: 0.8px;
                                    color: is_searching ? Theme.accent-primary : Theme.text-secondary;
                                    vertical-alignment: center;
                                }
                            }
                            if !is_searching && last_query != "" : Rectangle {
                                height: 26px; background: cp_t.has-hover ? Theme.surface-hover : Theme.surface-elevated;
                                border-radius: 4px; border-width: 1px; border-color: Theme.border;
                                HorizontalLayout {
                                    padding-left: 10px; padding-right: 10px; alignment: center;
                                    Text { text: "COPIAR"; font-size: 10px; font-weight: 800; color: Theme.accent-primary; vertical-alignment: center; }
                                }
                                cp_t := TouchArea { clicked => { root.copy_response_clicked(response_text); } }
                            }
                        }

                        TextInput {
                            text: response_text; read-only: true; font-size: 14px;
                            color: Theme.text-regular; wrap: word-wrap;
                        }
                    }

                    // 3. Fontes Auditadas Embutidas no Rodapé da Resposta
                    if !is_searching && last_query != "" : VerticalLayout {
                        spacing: 8px;
                        Text { text: "EVIDÊNCIAS & FONTES CONSULTADAS:"; font-size: 10px; font-weight: 700; letter-spacing: 0.6px; color: Theme.text-dim; }
                        HorizontalLayout {
                            spacing: 8px; alignment: start;
                            CitationPill { title: "Biblioteca Reductor (RRF Fusão)"; score: "97%"; }
                            CitationPill { title: "Indexed Technical Books"; score: "94%"; }
                        }
                    }
                }
            }
        }
    }
}
