import { Theme } from "../theme/palette.slint";

export component DayCell inherits Rectangle {
    in-out property <string> text: "1";
    in-out property <bool> is_today: false;
    in-out property <bool> is_other_month: false;

    width: 28px; height: 28px; border-radius: 14px;
    background: is_today ? Theme.accent-primary : (cell_touch.has-hover ? Theme.surface-hover : #00000000);
    animate background { duration: 100ms; }

    Text {
        text: text; font-size: 11px; font-weight: is_today ? 800 : 500;
        color: is_today ? #ffffff : (is_other_month ? Theme.text-dim : (cell_touch.has-hover ? #ffffff : Theme.text-regular));
        horizontal-alignment: center; vertical-alignment: center;
    }
    cell_touch := TouchArea { }
}

export component CalendarGrid inherits VerticalLayout {
    in-out property <int> month_offset: 0;
    spacing: 8px;

    HorizontalLayout {
        alignment: space-between;
        Text {
            text: month_offset == 0 ? "Setembro 2026" : (month_offset == 1 ? "Outubro 2026" : (month_offset == 2 ? "Novembro 2026" : (month_offset == -1 ? "Agosto 2026" : (month_offset == -2 ? "Julho 2026" : (month_offset > 0 ? "Mês " + (9 + month_offset) + " • 2026" : "Mês " + (9 + month_offset) + " • 2026")))));
            font-size: 12px; font-weight: 800; color: Theme.text-primary; vertical-alignment: center;
        }
        HorizontalLayout {
            spacing: 6px;
            Rectangle {
                width: 24px; height: 24px; border-radius: 6px;
                background: prev_touch.has-hover ? Theme.accent-primary : Theme.surface-elevated;
                border-width: 1px; border-color: prev_touch.has-hover ? Theme.accent-hover : Theme.border;
                animate background { duration: 100ms; }
                Path {
                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                    width: 6px; height: 10px;
                    stroke: prev_touch.has-hover ? #ffffff : Theme.text-secondary; stroke-width: 1.5px;
                    commands: "M 5 1 L 1 5 L 5 9";
                }
                prev_touch := TouchArea { clicked => { month_offset -= 1; } }
            }
            Rectangle {
                width: 24px; height: 24px; border-radius: 6px;
                background: next_touch.has-hover ? Theme.accent-primary : Theme.surface-elevated;
                border-width: 1px; border-color: next_touch.has-hover ? Theme.accent-hover : Theme.border;
                animate background { duration: 100ms; }
                Path {
                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                    width: 6px; height: 10px;
                    stroke: next_touch.has-hover ? #ffffff : Theme.text-secondary; stroke-width: 1.5px;
                    commands: "M 1 1 L 5 5 L 1 9";
                }
                next_touch := TouchArea { clicked => { month_offset += 1; } }
            }
        }
    }

    HorizontalLayout {
        alignment: space-between;
        Text { text: "D"; font-size: 10px; font-weight: 800; color: Theme.text-dim; horizontal-alignment: center; width: 28px; }
        Text { text: "S"; font-size: 10px; font-weight: 800; color: Theme.text-dim; horizontal-alignment: center; width: 28px; }
        Text { text: "T"; font-size: 10px; font-weight: 800; color: Theme.text-dim; horizontal-alignment: center; width: 28px; }
        Text { text: "Q"; font-size: 10px; font-weight: 800; color: Theme.text-dim; horizontal-alignment: center; width: 28px; }
        Text { text: "Q"; font-size: 10px; font-weight: 800; color: Theme.text-dim; horizontal-alignment: center; width: 28px; }
        Text { text: "S"; font-size: 10px; font-weight: 800; color: Theme.text-dim; horizontal-alignment: center; width: 28px; }
        Text { text: "S"; font-size: 10px; font-weight: 800; color: Theme.text-dim; horizontal-alignment: center; width: 28px; }
    }

    if month_offset == 0 : VerticalLayout {
        spacing: 3px;
        HorizontalLayout { alignment: space-between; DayCell { text: "30"; is_other_month: true; } DayCell { text: "31"; is_other_month: true; } DayCell { text: "1"; } DayCell { text: "2"; } DayCell { text: "3"; } DayCell { text: "4"; } DayCell { text: "5"; } }
        HorizontalLayout { alignment: space-between; DayCell { text: "6"; } DayCell { text: "7"; } DayCell { text: "8"; } DayCell { text: "9"; } DayCell { text: "10"; } DayCell { text: "11"; } DayCell { text: "12"; } }
        HorizontalLayout { alignment: space-between; DayCell { text: "13"; } DayCell { text: "14"; } DayCell { text: "15"; } DayCell { text: "16"; } DayCell { text: "17"; } DayCell { text: "18"; } DayCell { text: "19"; } }
        HorizontalLayout { alignment: space-between; DayCell { text: "20"; } DayCell { text: "21"; is_today: true; } DayCell { text: "22"; } DayCell { text: "23"; } DayCell { text: "24"; } DayCell { text: "25"; } DayCell { text: "26"; } }
        HorizontalLayout { alignment: space-between; DayCell { text: "27"; } DayCell { text: "28"; } DayCell { text: "29"; } DayCell { text: "30"; } DayCell { text: "1"; is_other_month: true; } DayCell { text: "2"; is_other_month: true; } DayCell { text: "3"; is_other_month: true; } }
    }

    if month_offset == 1 : VerticalLayout {
        spacing: 3px;
        HorizontalLayout { alignment: space-between; DayCell { text: "27"; is_other_month: true; } DayCell { text: "28"; is_other_month: true; } DayCell { text: "29"; is_other_month: true; } DayCell { text: "30"; is_other_month: true; } DayCell { text: "1"; } DayCell { text: "2"; } DayCell { text: "3"; } }
        HorizontalLayout { alignment: space-between; DayCell { text: "4"; } DayCell { text: "5"; } DayCell { text: "6"; } DayCell { text: "7"; } DayCell { text: "8"; } DayCell { text: "9"; } DayCell { text: "10"; } }
        HorizontalLayout { alignment: space-between; DayCell { text: "11"; } DayCell { text: "12"; } DayCell { text: "13"; } DayCell { text: "14"; } DayCell { text: "15"; } DayCell { text: "16"; } DayCell { text: "17"; } }
        HorizontalLayout { alignment: space-between; DayCell { text: "18"; } DayCell { text: "19"; } DayCell { text: "20"; } DayCell { text: "21"; } DayCell { text: "22"; } DayCell { text: "23"; } DayCell { text: "24"; } }
        HorizontalLayout { alignment: space-between; DayCell { text: "25"; } DayCell { text: "26"; } DayCell { text: "27"; } DayCell { text: "28"; } DayCell { text: "29"; } DayCell { text: "30"; } DayCell { text: "31"; } }
    }

    if month_offset != 0 && month_offset != 1 : VerticalLayout {
        spacing: 3px;
        HorizontalLayout { alignment: space-between; DayCell { text: "26"; is_other_month: true; } DayCell { text: "27"; is_other_month: true; } DayCell { text: "28"; is_other_month: true; } DayCell { text: "29"; is_other_month: true; } DayCell { text: "30"; is_other_month: true; } DayCell { text: "31"; is_other_month: true; } DayCell { text: "1"; } }
        HorizontalLayout { alignment: space-between; DayCell { text: "2"; } DayCell { text: "3"; } DayCell { text: "4"; } DayCell { text: "5"; } DayCell { text: "6"; } DayCell { text: "7"; } DayCell { text: "8"; } }
        HorizontalLayout { alignment: space-between; DayCell { text: "9"; } DayCell { text: "10"; } DayCell { text: "11"; } DayCell { text: "12"; } DayCell { text: "13"; } DayCell { text: "14"; } DayCell { text: "15"; } }
        HorizontalLayout { alignment: space-between; DayCell { text: "16"; } DayCell { text: "17"; } DayCell { text: "18"; } DayCell { text: "19"; } DayCell { text: "20"; } DayCell { text: "21"; } DayCell { text: "22"; } }
        HorizontalLayout { alignment: space-between; DayCell { text: "23"; } DayCell { text: "24"; } DayCell { text: "25"; } DayCell { text: "26"; } DayCell { text: "27"; } DayCell { text: "28"; } DayCell { text: "29"; } }
    }
}
