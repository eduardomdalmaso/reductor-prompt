import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme/palette.slint";

export component DocModal inherits Rectangle {
    in-out property <bool> is_open: false;
    in-out property <string> doc_title: "Rust Atomics and Locks";
    in-out property <string> doc_format: "PDF";
    in-out property <string> doc_meta: "Mara Bos • 242 Chunks • 68.420 Tokens";
    in-out property <string> doc_preview: "Capítulo 1: Concorrência e Primitivas Atômicas...\n\nMemória atômica garante que operações de leitura e escrita não sofram data races.";
    callback close_clicked();

    if is_open : Rectangle {
        width: 100%;
        height: 100%;
        background: #000000cc;

        TouchArea { clicked => { close_clicked(); } }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 720px;
            height: 480px;
            background: Theme.surface;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;

            VerticalLayout {
                padding: 24px;
                spacing: 14px;

                HorizontalLayout {
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: center;
                        Rectangle {
                            height: 24px;
                            background: Theme.accent-subtle;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #ff5e3a33;
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px;
                                Text { text: doc_format; font-size: 10px; font-weight: 800; color: Theme.accent-primary; vertical-alignment: center; }
                            }
                        }
                        Text { text: doc_title; font-size: 15px; font-weight: 800; color: Theme.text-primary; vertical-alignment: center; }
                    }

                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 8px;
                        background: close_touch.has-hover ? #ff003c22 : Theme.surface-elevated;
                        border-width: 1px;
                        border-color: close_touch.has-hover ? Theme.status-danger : Theme.border;

                        Path {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 12px;
                            height: 12px;
                            stroke: close_touch.has-hover ? Theme.status-danger : Theme.text-secondary;
                            stroke-width: 2px;
                            commands: "M 2 2 L 10 10 M 10 2 L 2 10";
                        }
                        close_touch := TouchArea { clicked => { close_clicked(); } }
                    }
                }

                Text { text: doc_meta; font-size: 11px; color: Theme.text-dim; }
                Rectangle { height: 1px; background: Theme.border; }

                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.surface-elevated;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.border;

                    ScrollView {
                        VerticalLayout {
                            padding: 18px;
                            Text { text: doc_preview; font-size: 13px; color: Theme.text-regular; wrap: word-wrap; }
                        }
                    }
                }
            }
        }
    }
}
