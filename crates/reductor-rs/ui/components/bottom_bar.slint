import { Theme } from "../theme/palette.slint";

export component BottomBar inherits Rectangle {
    in-out property <string> query_text <=> input-field.text;
    in-out property <string> active_mode: "Standard";
    in-out property <bool> is_searching: false;
    callback query_submitted(string);
    callback clear_clicked();
    callback mode_toggled();

    height: 76px;
    background: Theme.background;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding: 12px;
        Rectangle {
            horizontal-stretch: 1;
            height: 52px;
            background: Theme.surface;
            border-radius: 10px;
            border-width: 1px;
            border-color: input-field.has-focus ? Theme.accent-primary : Theme.border;

            GridLayout {
                padding: 6px;
                spacing: 8px;

                // Col 0: Modo
                Rectangle {
                    col: 0; width: 125px; height: 38px;
                    background: mode_touch.has-hover ? Theme.surface-hover : Theme.surface-elevated;
                    border-radius: 6px; border-width: 1px; border-color: Theme.border;
                    HorizontalLayout {
                        alignment: center; spacing: 6px;
                        Text { text: "MODO:"; font-size: 10px; font-weight: 700; color: Theme.text-dim; vertical-alignment: center; }
                        Text { text: active_mode; font-size: 11px; font-weight: 700; color: Theme.accent-primary; vertical-alignment: center; }
                    }
                    mode_touch := TouchArea { clicked => { mode_toggled(); } }
                }

                // Col 1: Input
                Rectangle {
                    col: 1; horizontal-stretch: 1; min-width: 200px; height: 38px;
                    background: Theme.surface-input; border-radius: 6px; border-width: 1px;
                    border-color: input-field.has-focus ? Theme.border-focus : Theme.border;
                    clip: true;

                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px;
                        input-field := TextInput {
                            horizontal-stretch: 1; color: Theme.text-primary; font-size: 13px; vertical-alignment: center;
                            accepted => { if (self.text != "") { let q = self.text; self.text = ""; query_submitted(q); } }
                        }
                    }

                    if input-field.text == "" && !input-field.has-focus : HorizontalLayout {
                        padding-left: 12px; alignment: start;
                        Text { text: "Digite sua dúvida técnica para auditar com os livros..."; font-size: 13px; color: Theme.text-dim; vertical-alignment: center; }
                    }
                }

                // Col 2: Limpar
                Rectangle {
                    col: 2; width: 85px; height: 38px;
                    background: clear_touch.has-hover ? Theme.surface-hover : Theme.surface-elevated;
                    border-radius: 6px; border-width: 1px;
                    border-color: clear_touch.has-hover ? Theme.border-focus : Theme.border;
                    HorizontalLayout {
                        alignment: center;
                        Text { text: "LIMPAR"; color: Theme.text-secondary; font-size: 11px; font-weight: 700; letter-spacing: 0.6px; vertical-alignment: center; }
                    }
                    clear_touch := TouchArea { clicked => { input-field.text = ""; clear_clicked(); } }
                }

                // Col 3: Enviar
                Rectangle {
                    col: 3; width: 105px; height: 38px;
                    background: btn_touch.pressed ? Theme.accent-active : (btn_touch.has-hover ? Theme.accent-hover : Theme.accent-primary);
                    border-radius: 6px;
                    HorizontalLayout {
                        alignment: center;
                        Text { text: is_searching ? "BUSCANDO" : "ENVIAR"; color: #ffffff; font-size: 11px; font-weight: 800; letter-spacing: 0.8px; vertical-alignment: center; }
                    }
                    btn_touch := TouchArea { clicked => { if (input-field.text != "") { let q = input-field.text; input-field.text = ""; query_submitted(q); } } }
                }
            }
        }
    }
}
