import { Theme } from "../theme/palette.slint";
import { ChatView, CitationItem } from "chat_view.slint";
import { BottomBar } from "bottom_bar.slint";
import { DatasetView, DocItem } from "dataset_view.slint";
import { McpView, TokenItem } from "mcp_view.slint";
import { ModelHubView, ModelItem, ProviderItem } from "model_hub_view.slint";
import { MetricsView, HistoryItem } from "metrics_view.slint";
import { ApiDocsView } from "api_docs_view.slint";

export { DocItem, TokenItem, ModelItem, ProviderItem, HistoryItem, CitationItem }

export component PageRouter inherits Rectangle {
    in-out property <string> current_page: "cockpit";
    in-out property <string> last_query: "";
    in-out property <string> response_text: "";
    in-out property <bool> is_searching: false;
    in-out property <[CitationItem]> citations_data: [];
    in-out property <string> query_text: "";
    in-out property <string> active_mode: "Standard";
    in-out property <[DocItem]> docs_data: [];
    in-out property <[TokenItem]> tokens_data: [];
    in-out property <string> active_mcp_token: "";
    in-out property <[ModelItem]> local_models_data: [];
    in-out property <[ProviderItem]> cloud_providers_data: [];
    in-out property <string> gpu_status: "";
    in-out property <[HistoryItem]> history_data: [];
    in-out property <string> kpi_saved_tokens: "0.0%";
    in-out property <string> kpi_saved_tokens_sub: "0 tokens evitados";
    in-out property <string> kpi_total_queries: "0";
    in-out property <string> kpi_avg_latency: "0ms";
    in-out property <string> kpi_saved_cost: "$0.00";
    in-out property <float> compression_ratio: 0.0;
    in-out property <string> compression_text: "Aguardando primeira consulta para calcular compressão...";

    callback query_submitted(string);
    callback copy_response(string);
    callback open_doc(string, string, string, string);
    callback add_doc_clicked();
    callback generate_mcp_token(string);
    callback copy_mcp_token(string);
    callback delete_mcp_token(string);
    callback pull_model(string);
    callback configure_provider(string);

    if current_page == "cockpit" : VerticalLayout {
        horizontal-stretch: 1; padding: 0px; spacing: 0px;
        ChatView {
            vertical-stretch: 1; last_query: root.last_query; response_text: root.response_text;
            is_searching: root.is_searching; citations: root.citations_data;
            copy_response_clicked(text) => { root.copy_response(text); }
        }
        BottomBar {
            vertical-stretch: 0; query_text <=> root.query_text; active_mode <=> root.active_mode; is_searching <=> root.is_searching;
            query_submitted(q) => { root.query_submitted(q); }
            clear_clicked => { root.query_text = ""; root.last_query = ""; root.response_text = "Pronto para consultas."; }
            mode_toggled => {
                if (root.active_mode == "Standard") { root.active_mode = "Deep"; }
                else if (root.active_mode == "Deep") { root.active_mode = "Fast"; }
                else if (root.active_mode == "Fast") { root.active_mode = "Context"; }
                else { root.active_mode = "Standard"; }
            }
        }
    }

    if current_page == "dataset" : DatasetView {
        horizontal-stretch: 1; docs: root.docs_data;
        open_doc(t, f, m, p) => { root.open_doc(t, f, m, p); }
        add_doc_clicked => { root.add_doc_clicked(); }
    }

    if current_page == "mcp" : McpView {
        horizontal-stretch: 1; tokens: root.tokens_data; active_token: root.active_mcp_token;
        generate_token(p) => { root.generate_mcp_token(p); }
        copy_token(t) => { root.copy_mcp_token(t); }
        delete_token(id) => { root.delete_mcp_token(id); }
    }

    if current_page == "models" : ModelHubView {
        horizontal-stretch: 1; local_models: root.local_models_data;
        cloud_providers: root.cloud_providers_data; gpu_status: root.gpu_status;
        pull_model_clicked(m) => { root.pull_model(m); }
        configure_provider_clicked(p) => { root.configure_provider(p); }
    }

    if current_page == "metrics" : MetricsView {
        horizontal-stretch: 1; history_items: root.history_data;
        kpi_saved_tokens: root.kpi_saved_tokens; kpi_saved_tokens_sub: root.kpi_saved_tokens_sub;
        kpi_total_queries: root.kpi_total_queries; kpi_avg_latency: root.kpi_avg_latency;
        kpi_saved_cost: root.kpi_saved_cost; compression_ratio: root.compression_ratio;
        compression_text: root.compression_text;
    }

    if current_page == "api" : ApiDocsView { horizontal-stretch: 1; }
}
