import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme/palette.slint";
import { ModelCard } from "model_card.slint";
import { ProviderCard } from "provider_card.slint";
import { QuickInstaller } from "quick_installer.slint";

export struct ModelItem {
    name: string,
    tag: string,
    size_text: string,
    is_installed: bool,
    is_active: bool,
    is_downloading: bool,
}

export struct ProviderItem {
    name: string,
    models: string,
    api_key_masked: string,
    is_connected: bool,
    provider_id: string,
}

export component ModelHubView inherits Rectangle {
    in-out property <string> gpu_status: "● Detectando LLM Local...";
    in-out property <[ModelItem]> local_models: [];
    in-out property <[ProviderItem]> cloud_providers: [];
    callback pull_model_clicked(string);
    callback configure_provider_clicked(string);

    background: Theme.background;

    VerticalLayout {
        padding: 24px;
        spacing: 14px;

        // Header do Hub
        HorizontalLayout {
            alignment: space-between;
            VerticalLayout {
                spacing: 3px;
                Text { text: "CATÁLOGO DE MODELOS LOCAIS & PROVEDORES"; font-size: 15px; font-weight: 800; letter-spacing: 0.8px; color: Theme.text-primary; }
                Text { text: "Clique em 'BAIXAR' no catálogo ou escolha uma das sugestões para instalar no Ollama."; font-size: 11px; color: Theme.text-dim; }
            }
            Rectangle {
                height: 26px; background: #00ff9d14; border-radius: 4px; border-width: 1px; border-color: #00ff9d33;
                HorizontalLayout {
                    padding-left: 10px; padding-right: 10px;
                    Text { text: gpu_status; font-size: 10px; font-weight: 800; color: Theme.status-success; vertical-alignment: center; }
                }
            }
        }

        // Card de Instalação com Sugestões Clicáveis
        QuickInstaller {
            pull_clicked(m) => { root.pull_model_clicked(m); }
        }

        // Lista de Modelos do Catálogo e Provedores
        Rectangle {
            vertical-stretch: 1; background: Theme.surface; border-radius: 10px; border-width: 1px; border-color: Theme.border;
            ScrollView {
                VerticalLayout {
                    padding: 16px; spacing: 14px;

                    VerticalLayout {
                        spacing: 6px;
                        Text { text: "CATÁLOGO DE MODELOS TÉCNICOS (OLLAMA)"; font-size: 11px; font-weight: 800; color: Theme.text-secondary; }
                        for m in local_models : ModelCard {
                            model_name: m.name;
                            model_tag: m.tag;
                            size_text: m.size_text;
                            is_installed: m.is_installed;
                            is_active: m.is_active;
                            is_downloading: m.is_downloading;
                            action_clicked => { if (!m.is_installed) { root.pull_model_clicked(m.name); } }
                        }
                    }

                    VerticalLayout {
                        spacing: 6px;
                        Text { text: "PROVEDORES EXTERNOS EM NUVEM (FALLBACK & AGENTES)"; font-size: 11px; font-weight: 800; color: Theme.text-secondary; }
                        for p in cloud_providers : ProviderCard {
                            provider_name: p.name;
                            provider_models: p.models;
                            api_key_masked: p.api_key_masked;
                            is_connected: p.is_connected;
                            configure_clicked => { configure_provider_clicked(p.provider_id); }
                        }
                    }
                }
            }
        }
    }
}
