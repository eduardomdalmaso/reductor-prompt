import { Theme } from "../theme/palette.slint";

export component TokenRow inherits Rectangle {
    in-out property <string> project_name: "HydraVMS Agent";
    in-out property <string> token_mask: "rdk_live_9a8f...4e2b";
    in-out property <string> created_at: "21/09/2026";
    in-out property <bool> is_active: true;
    callback copy_clicked();
    callback delete_clicked();

    height: 52px;
    background: Theme.surface-elevated;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;
        alignment: space-between;

        // Esquerda: Status + Nome + Hash (Centralizado perfeitamente)
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 8px; height: 8px; border-radius: 4px;
                    background: is_active ? Theme.status-success : Theme.status-danger;
                }
            }
            VerticalLayout {
                alignment: center;
                Text { text: project_name; font-size: 12px; font-weight: 700; color: Theme.text-primary; }
            }
            VerticalLayout {
                alignment: center;
                Text { text: "• " + token_mask; font-size: 11px; color: Theme.accent-primary; }
            }
        }

        // Direita: Data + Ícone Copiar + Ícone Deletar (Centralizados)
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                Text { text: created_at; font-size: 10px; color: Theme.text-dim; }
            }

            // Ícone Copiar
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 32px; height: 32px; border-radius: 6px;
                    background: copy_touch.has-hover ? Theme.accent-primary : Theme.surface-input;
                    border-width: 1px; border-color: copy_touch.has-hover ? Theme.accent-hover : Theme.border;
                    animate background { duration: 100ms; }

                    Path {
                        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                        width: 14px; height: 14px;
                        stroke: copy_touch.has-hover ? #ffffff : Theme.accent-primary;
                        stroke-width: 1.5px;
                        commands: "M 3 4 L 3 13 L 10 13 L 10 4 Z M 6 4 L 6 1 L 13 1 L 13 10 L 10 10";
                    }
                    copy_touch := TouchArea { clicked => { copy_clicked(); } }
                }
            }

            // Ícone Deletar
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 32px; height: 32px; border-radius: 6px;
                    background: del_touch.has-hover ? #ff003c22 : Theme.surface-input;
                    border-width: 1px; border-color: del_touch.has-hover ? Theme.status-danger : Theme.border;
                    animate background { duration: 100ms; }

                    Path {
                        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                        width: 12px; height: 14px;
                        stroke: del_touch.has-hover ? Theme.status-danger : Theme.text-dim;
                        stroke-width: 1.5px;
                        commands: "M 1 3 L 11 3 M 4 1 L 8 1 M 2 3 L 3 13 L 9 13 L 10 3";
                    }
                    del_touch := TouchArea { clicked => { delete_clicked(); } }
                }
            }
        }
    }
}
