import { Theme } from "../theme/palette.slint";

export component BookItem inherits Rectangle {
    in-out property <string> title: "";
    in-out property <string> author_meta: "";

    height: 52px;
    background: Theme.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 2px;

        Text { text: title; font-size: 12px; font-weight: 600; color: Theme.text-primary; }
        Text { text: author_meta; font-size: 10px; color: Theme.text-secondary; }
    }
}

export component BookSidebar inherits Rectangle {
    width: 290px;
    background: Theme.background;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        padding: 18px;
        spacing: 14px;

        // Header da Sidebar
        HorizontalLayout {
            alignment: space-between;
            Text {
                text: "ACERVO INDEXADO";
                font-size: 11px;
                font-weight: 700;
                color: Theme.text-secondary;
                vertical-alignment: center;
            }
            Rectangle {
                height: 20px;
                background: Theme.accent-subtle;
                border-radius: 4px;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    Text {
                        text: "38 Fontes";
                        font-size: 10px;
                        font-weight: 700;
                        color: Theme.accent-primary;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Lista de Livros
        VerticalLayout {
            spacing: 8px;
            BookItem { title: "Rust Atomics & Locks"; author_meta: "Mara Bos • 242 Chunks"; }
            BookItem { title: "Domain-Driven Hexagon"; author_meta: "Sairyss • 60 Chunks"; }
            BookItem { title: "Slint UI Documentation"; author_meta: "Slint Team • 85 Chunks"; }
            BookItem { title: "Building Microservices 2E"; author_meta: "Sam Newman • 600 Chunks"; }
        }

        // Rodapé de Memória Vetorial
        Rectangle {
            height: 38px;
            background: Theme.surface-elevated;
            border-radius: 6px;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: space-between;

                Text { text: "Memória Vetorial"; font-size: 11px; color: Theme.text-secondary; vertical-alignment: center; }
                Text { text: "15.420 Vetores"; font-size: 11px; font-weight: 700; color: Theme.status-success; vertical-alignment: center; }
            }
        }
    }
}
