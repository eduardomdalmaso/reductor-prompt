import { Theme } from "../theme/palette.slint";

export component HeaderBar inherits Rectangle {
    in-out property <string> tokens_saved_pct: "0.0%";
    in-out property <bool> sidebar_open: true;
    in-out property <string> date_time_text: "Seg 21 Set • 16:12";
    in-out property <bool> has_system_alarm: true;
    callback toggle_sidebar_clicked();
    callback logout_clicked();
    callback calendar_clicked();

    height: 54px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding-top: 10px; padding-bottom: 10px; padding-left: 18px; padding-right: 20px;
        alignment: space-between;

        // 1. Esquerda: Toggle Sidebar + Logo RP
        HorizontalLayout {
            spacing: 14px; alignment: center;

            Rectangle {
                width: 34px; height: 34px;
                background: toggle_touch.has-hover ? Theme.surface-hover : Theme.surface-elevated;
                border-radius: 6px; border-width: 1px; border-color: Theme.border;
                animate background { duration: 100ms; }

                Path {
                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                    width: 6px; height: 10px;
                    stroke: Theme.accent-primary; stroke-width: 1.5px;
                    commands: sidebar_open ? "M 5 1 L 1 5 L 5 9" : "M 1 1 L 5 5 L 1 9";
                }
                toggle_touch := TouchArea { clicked => { toggle_sidebar_clicked(); } }
            }

            HorizontalLayout {
                spacing: 8px; alignment: center;
                Rectangle {
                    width: 28px; height: 28px; background: Theme.accent-subtle;
                    border-radius: 6px; border-width: 1px; border-color: Theme.accent-primary;
                    Text { text: "RP"; font-size: 12px; font-weight: 800; color: Theme.accent-primary; horizontal-alignment: center; vertical-alignment: center; }
                }
                Text { text: "REDUCTOR PROMPT"; font-size: 13px; font-weight: 800; letter-spacing: 0.8px; color: Theme.text-primary; vertical-alignment: center; }
            }
        }

        // 2. Centro: Calendário & Relógio Estilo GNOME com Indicador de Alarmes
        Rectangle {
            height: 34px;
            background: cal_touch.has-hover ? Theme.surface-hover : Theme.surface-elevated;
            border-radius: 8px;
            border-width: 1px;
            border-color: has_system_alarm ? #ff003c44 : (cal_touch.has-hover ? Theme.accent-primary : Theme.border);
            animate background { duration: 120ms; }

            HorizontalLayout {
                padding-left: 14px; padding-right: 14px; spacing: 8px; alignment: center;

                // Bolinha de alarme perfeitamente centralizada verticalmente
                if has_system_alarm : VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 6px; height: 6px; border-radius: 3px; background: Theme.status-danger;
                    }
                }

                Text {
                    text: date_time_text;
                    font-size: 12px; font-weight: 700; letter-spacing: 0.4px;
                    color: cal_touch.has-hover ? #ffffff : Theme.text-regular;
                    vertical-alignment: center;
                }
            }
            cal_touch := TouchArea { clicked => { calendar_clicked(); } }
        }

        // 3. Direita: Métricas e Logout
        HorizontalLayout {
            spacing: 12px; alignment: center;
            Rectangle {
                height: 26px; background: Theme.accent-subtle; border-radius: 4px; border-width: 1px; border-color: Theme.accent-primary;
                HorizontalLayout {
                    padding-left: 10px; padding-right: 10px; alignment: center;
                    Text { text: "TOKENS: " + tokens_saved_pct; font-size: 11px; font-weight: 700; letter-spacing: 0.5px; color: Theme.accent-primary; vertical-alignment: center; }
                }
            }

            Rectangle {
                height: 30px; background: logout_touch.has-hover ? Theme.surface-hover : Theme.surface-elevated;
                border-radius: 6px; border-width: 1px; border-color: logout_touch.has-hover ? Theme.status-danger : Theme.border;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px; alignment: center;
                    Text { text: "SAIR"; color: Theme.status-danger; font-size: 11px; font-weight: 700; letter-spacing: 0.5px; vertical-alignment: center; }
                }
                logout_touch := TouchArea { clicked => { logout_clicked(); } }
            }
        }
    }
}
