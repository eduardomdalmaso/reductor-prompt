import { Theme } from "../theme/palette.slint";

export component IngestModal inherits Rectangle {
    in-out property <bool> is_open: false;
    in-out property <string> file_name: "meu_livro.pdf";
    in-out property <string> current_step: "Iniciando ingestão...";
    in-out property <float> progress: 0.0;
    in-out property <string> status_log: "Aguardando processamento...";
    in-out property <bool> is_finished: false;
    callback close_clicked();

    if is_open : Rectangle {
        width: 100%;
        height: 100%;
        background: #000000dd;

        TouchArea { } // Bloqueia cliques fora durante o processo

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 620px;
            height: 380px;
            background: Theme.surface;
            border-radius: 12px;
            border-width: 1px;
            border-color: is_finished ? #00ff9d55 : #ff5e3a55;
            clip: true;

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                // Header
                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        spacing: 3px;
                        Text {
                            text: is_finished ? "INDEXAÇÃO CONCLUÍDA NO CHROMADB" : "PROCESSANDO & INDEXANDO DOCUMENTO";
                            font-size: 14px;
                            font-weight: 800;
                            letter-spacing: 0.6px;
                            color: is_finished ? Theme.status-success : Theme.accent-primary;
                        }
                        Text { text: file_name; font-size: 12px; font-weight: 700; color: Theme.text-primary; overflow: elide; }
                    }
                }

                // Barra de Progresso
                VerticalLayout {
                    spacing: 6px;
                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: current_step; font-size: 11px; font-weight: 700; color: Theme.text-regular; }
                        Text { text: "\{Math.round(progress * 100)}%"; font-size: 11px; font-weight: 800; color: is_finished ? Theme.status-success : Theme.accent-primary; }
                    }

                    Rectangle {
                        height: 8px;
                        background: Theme.surface-elevated;
                        border-radius: 4px;
                        clip: true;

                        Rectangle {
                            x: 0px;
                            y: 0px;
                            width: parent.width * progress;
                            height: 100%;
                            background: is_finished ? Theme.status-success : Theme.accent-primary;
                            border-radius: 4px;
                        }
                    }
                }

                // Log de Status em Tempo Real
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.surface-elevated;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Theme.border;

                    VerticalLayout {
                        padding: 12px;
                        Text {
                            text: status_log;
                            font-size: 11px;
                            color: Theme.text-dim;
                            wrap: word-wrap;
                        }
                    }
                }

                // Botão Fechar / Concluir
                if is_finished : HorizontalLayout {
                    alignment: end;
                    Rectangle {
                        width: 130px;
                        height: 36px;
                        background: close_btn_touch.has-hover ? #00ff9d : #00ff9dcc;
                        border-radius: 6px;
                        animate background { duration: 120ms; }

                        HorizontalLayout {
                            alignment: center;
                            Text { text: "CONCLUIR"; font-size: 11px; font-weight: 800; color: #07080c; vertical-alignment: center; }
                        }

                        close_btn_touch := TouchArea {
                            clicked => { close_clicked(); }
                        }
                    }
                }
            }
        }
    }
}
