export global Theme {
    // HydraVMS Core 3-Color Visual Identity
    out property <color> background: #07080c;           // --vms-bg-base
    out property <color> surface: #0e1117;              // --vms-bg-surface
    out property <color> surface-elevated: #14171d;     // --vms-bg-elevated
    out property <color> surface-hover: #1c212a;        // --vms-bg-elevated-hover
    out property <color> surface-input: #06070a;        // --vms-neu-bg inset
    
    // Bordas Sutis HydraVMS
    out property <color> border: #1e222d;               // 1px subtle dark border
    out property <color> border-light: #282e3d;         // 1px light border
    out property <color> border-focus: #ff5e3a;         // Hydra Orange
    
    // Tipografia HydraVMS
    out property <color> text-primary: #ffffff;         // --vms-text-main
    out property <color> text-regular: #cbd5e1;         // --vms-text-regular
    out property <color> text-secondary: #8b94a0;       // --vms-text-muted
    out property <color> text-dim: #5a626f;             // --vms-text-dim
    
    // Acentos HydraVMS
    out property <color> accent-primary: #ff5e3a;       // --vms-color-orange
    out property <color> accent-hover: #ff7250;         // --vms-primary-hover
    out property <color> accent-active: #e04826;        // --vms-primary-active
    out property <color> accent-subtle: #ff5e3a1f;      // --vms-primary-subtle
    
    // Status Neon HydraVMS
    out property <color> status-success: #00ff9d;       // --vms-success neon
    out property <color> status-danger: #ff003c;        // --vms-danger
    out property <color> status-info: #00f0ff;          // --vms-info
    out property <color> status-warning: #fcee0a;       // --vms-warning
}
