import { Theme } from "theme/palette.slint";
import { LoginCard } from "components/login_card.slint";
import { HeaderBar } from "components/header_bar.slint";
import { SidebarNav } from "components/sidebar_nav.slint";
import { PageRouter, DocItem, TokenItem, ModelItem, ProviderItem, HistoryItem, CitationItem } from "components/page_router.slint";
import { DocModal } from "components/doc_modal.slint";
import { IngestModal } from "components/ingest_modal.slint";
import { GnomeCalendar } from "components/gnome_calendar.slint";

export { DocItem, TokenItem, ModelItem, ProviderItem, HistoryItem, CitationItem }

export component AppWindow inherits Window {
    title: "ReductorPrompt - Local AI & Knowledge Engine";
    min-width: 1024px; min-height: 680px; preferred-width: 1200px; preferred-height: 780px;
    background: Theme.background;

    in-out property <bool> is_logged_in: false;
    in-out property <string> username_input: "admin"; in-out property <string> password_input: "admin"; in-out property <string> error_message: "";
    in-out property <string> query_text: ""; in-out property <string> last_query: ""; in-out property <string> response_text: "Pronto para consultas técnicas. Digite sua dúvida na barra inferior.";
    in-out property <string> tokens_saved_pct: "0.0%"; in-out property <string> latency_text: "0ms"; in-out property <string> active_mode: "Standard";
    in-out property <bool> is_searching: false; in-out property <bool> is_sidebar_open: true; in-out property <string> current_page: "cockpit";
    in-out property <bool> is_modal_open: false; in-out property <string> modal_title: ""; in-out property <string> modal_format: ""; in-out property <string> modal_meta: ""; in-out property <string> modal_preview: "";

    in-out property <bool> is_calendar_open: false; in-out property <bool> is_ingesting: false; in-out property <string> ingest_filename: "";
    in-out property <string> ingest_step: ""; in-out property <float> ingest_progress: 0.0; in-out property <string> ingest_log: ""; in-out property <bool> ingest_finished: false;

    // Modelos Dinâmicos Livres de Mock
    in-out property <[DocItem]> docs_data: [];
    in-out property <[TokenItem]> tokens_data: [];
    in-out property <string> active_mcp_token_val: "";
    in-out property <[ModelItem]> local_models_data: [];
    in-out property <[ProviderItem]> cloud_providers_data: [];
    in-out property <[CitationItem]> citations_data: [];
    in-out property <string> gpu_status_val: "● Verificando Ollama..."; in-out property <[HistoryItem]> history_data: [];
    in-out property <string> total_chunks_counter: "0 Chunks"; in-out property <string> kpi_tokens_saved_val: "0.0%"; in-out property <string> kpi_tokens_saved_sub_val: "0 tokens evitados";
    in-out property <string> kpi_total_queries_val: "0"; in-out property <string> kpi_avg_latency_val: "0ms"; in-out property <string> kpi_saved_cost_val: "$0.00";
    in-out property <float> compression_ratio_val: 0.0; in-out property <string> compression_text_val: "Aguardando primeira consulta...";

    in-out property <string> cal_time_val: ""; in-out property <string> cal_date_val: "";
    in-out property <bool> cal_chroma_offline: false; in-out property <string> cal_chroma_status: "Motor Vetorial Nativo Rust Persistente Operacional.";
    in-out property <string> cal_ollama_title: "● Provedor LLM: Ollama Local (11434)"; in-out property <string> cal_ollama_desc: "Verificando...";
    in-out property <string> cal_dataset_desc: "0 Livros indexados.";

    callback login_requested(string, string);
    callback logout_requested();
    callback query_submitted(string);
    callback copy_response_requested(string);
    callback add_books_dialog_requested();
    callback generate_mcp_token_requested(string);
    callback delete_mcp_token_requested(string);
    callback copy_mcp_token_requested(string);
    callback pull_model_requested(string);
    callback configure_provider_requested(string);

    if !is_logged_in : HorizontalLayout {
        alignment: center;
        VerticalLayout {
            alignment: center;
            LoginCard {
                username <=> username_input; password_val <=> password_input; error_message <=> error_message;
                login_submitted => {
                    if (username_input == "admin" && password_input == "admin") { is_logged_in = true; error_message = ""; login_requested(username_input, password_input); }
                    else { error_message = "Credenciais inválidas. Use admin / admin."; }
                }
            }
        }
    }

    if is_logged_in : VerticalLayout {
        padding: 0px; spacing: 0px;
        HeaderBar {
            vertical-stretch: 0; tokens_saved_pct: tokens_saved_pct; sidebar_open: is_sidebar_open;
            calendar_clicked => { is_calendar_open = !is_calendar_open; }
            toggle_sidebar_clicked => { is_sidebar_open = !is_sidebar_open; }
            logout_clicked => { is_logged_in = false; logout_requested(); }
        }

        HorizontalLayout {
            vertical-stretch: 1; padding: 0px; spacing: 0px;
            SidebarNav {
                is_open: is_sidebar_open; current_page: current_page; total_chunks_text: total_chunks_counter;
                page_changed(p) => { current_page = p; }
            }

            PageRouter {
                horizontal-stretch: 1; current_page: current_page; last_query: last_query; response_text: response_text;
                is_searching: is_searching; query_text <=> query_text; active_mode <=> active_mode;
                citations_data: citations_data; docs_data: docs_data; tokens_data: tokens_data; active_mcp_token: active_mcp_token_val;
                local_models_data: local_models_data; cloud_providers_data: cloud_providers_data; gpu_status: gpu_status_val; history_data: history_data;
                kpi_saved_tokens: kpi_tokens_saved_val; kpi_saved_tokens_sub: kpi_tokens_saved_sub_val;
                kpi_total_queries: kpi_total_queries_val; kpi_avg_latency: kpi_avg_latency_val;
                kpi_saved_cost: kpi_saved_cost_val; compression_ratio: compression_ratio_val;
                compression_text: compression_text_val;
                query_submitted(q) => { root.last_query = q; root.query_submitted(q); }
                copy_response(t) => { root.copy_response_requested(t); }
                open_doc(t, f, m, p) => { root.modal_title = t; root.modal_format = f; root.modal_meta = m; root.modal_preview = p; root.is_modal_open = true; }
                add_doc_clicked => { root.add_books_dialog_requested(); }
                generate_mcp_token(p) => { root.generate_mcp_token_requested(p); }
                copy_mcp_token(t) => { root.copy_mcp_token_requested(t); }
                delete_mcp_token(id) => { root.delete_mcp_token_requested(id); }
                pull_model(m) => { root.pull_model_requested(m); }
                configure_provider(p) => { root.configure_provider_requested(p); }
            }
        }
    }

    GnomeCalendar {
        is_open: is_calendar_open; current_time: cal_time_val; current_date_str: cal_date_val;
        chromadb_is_offline: cal_chroma_offline; chromadb_status_text: cal_chroma_status;
        ollama_status_title: cal_ollama_title; ollama_status_desc: cal_ollama_desc;
        dataset_status_desc: cal_dataset_desc; close_clicked => { is_calendar_open = false; }
    }
    DocModal { is_open: is_modal_open; doc_title: modal_title; doc_format: modal_format; doc_meta: modal_meta; doc_preview: modal_preview; close_clicked => { is_modal_open = false; } }
    IngestModal { is_open: is_ingesting; file_name: ingest_filename; current_step: ingest_step; progress: ingest_progress; status_log: ingest_log; is_finished: ingest_finished; close_clicked => { is_ingesting = false; } }
}
